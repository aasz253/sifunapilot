# SifunaPilot Configuration

# AI Settings
SIFUNAPILOT_AI__PROVIDER=ollama
SIFUNAPILOT_AI__MODEL=llama3.1
SIFUNAPILOT_AI__HOST=http://localhost:11434

# Agent Settings
SIFUNAPILOT_AGENT__MODE=assist
SIFUNAPILOT_AGENT__MAX_STEPS=30
SIFUNAPILOT_AGENT__REQUIRE_CONFIRMATION=true

# Voice Settings
SIFUNAPILOT_VOICE__ENABLED=false

# Browser Settings
SIFUNAPILOT_BROWSER__BROWSER=chromium
SIFUNAPILOT_BROWSER__HEADLESS=false
